// ====== 心跳动画增强版 ======
@keyframes heartbeat
  0%
    transform translateY(0) scale(1) rotate(0deg)
  15%
    transform translateY(-30px) scale(1.2) rotate(-3deg)
  30%
    transform translateY(-40px) scale(1.25) rotate(2deg)
  45%
    transform translateY(-25px) scale(1.15) rotate(-2deg)
  60%
    transform translateY(-35px) scale(1.2) rotate(3deg)
  75%
    transform translateY(-20px) scale(1.1) rotate(-1deg)
  90%
    transform translateY(-30px) scale(1.15) rotate(2deg)
  100%
    transform translateY(0) scale(1) rotate(0deg)

// ====== 阴影动画增强版 ======
@keyframes shadow-beat
  0%
    transform translateX(-50%) scaleX(1) scaleY(1)
    opacity 0.6
  15%
    transform translateX(-50%) scaleX(2.5) scaleY(0.3)
    opacity 0.1
  30%
    transform translateX(-50%) scaleX(3.0) scaleY(0.2)
    opacity 0.05
  45%
    transform translateX(-50%) scaleX(2.2) scaleY(0.4)
    opacity 0.15
  60%
    transform translateX(-50%) scaleX(2.8) scaleY(0.25)
    opacity 0.08
  75%
    transform translateX(-50%) scaleX(2.0) scaleY(0.5)
    opacity 0.2
  90%
    transform translateX(-50%) scaleX(2.4) scaleY(0.35)
    opacity 0.1
  100%
    transform translateX(-50%) scaleX(1) scaleY(1)
    opacity 0.6

// ====== 爱心容器和毛玻璃效果增强版 ======
.heart-container
  position relative
  display inline-block
  margin 0 10px
  .heart-icon
    position relative
    z-index 2
    font-size 2.5rem
    filter drop-shadow(0 8px 16px rgba(0,0,0,0.4))
    text-shadow 0 6px 12px rgba(0,0,0,0.3)
    transform-style preserve-3d
    perspective 1000px
    transition all 0.3s ease
    &:hover
      transform scale(1.2) rotateY(15deg) rotateZ(5deg)
      filter drop-shadow(0 12px 24px rgba(0,0,0,0.5))
  .heart-shadow
    position absolute
    bottom -18px
    left 50%
    width 70px
    height 25px
    border-radius 50%
    background rgba(128,128,128,0.6) !important
    filter blur(10px)
    z-index 1
    transition all 0.3s ease

// ====== 主题色与基础变量 ======
$primary = #b388ff
$secondary = #4a9ff5
$accent = #ff7eb3
$glass-bg = rgba(255,255,255,0.55)
$glass-border = rgba(255,255,255,0.7)
$text-main = #2c3e50
$shadow = 0 8px 32px rgba(31,38,135,0.15)

// ====== 顶部大卡片 ======
.update-header
  max-width 900px
  margin 40px auto 30px auto
  padding 36px 24px 28px 24px
  border-radius 28px
  box-shadow 0 8px 32px rgba(180,136,255,0.10)
  text-align center
  position relative
  z-index 2
  overflow hidden
  
  // 视频背景容器
  &::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index -2
    
  // 视频元素
  video
    position absolute
    top 50%
    left 50%
    min-width 100%
    min-height 100%
    width auto
    height auto
    transform translate(-50%, -50%)
    z-index -2
    object-fit cover
    
  // 毛玻璃遮罩
  &::after
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background rgba(255, 255, 255, 0.03)
    backdrop-filter blur(3px)
    -webkit-backdrop-filter blur(3px)
    z-index -1

  h1.page-title
    font-size 2.5rem
    font-weight 800
    color $primary
    letter-spacing 2px
    margin-bottom 10px
    display flex
    align-items center
    justify-content center
    i
      font-size 2.1rem
      margin-right 10px

  .update-subtitle
    color #6a7ba2
    font-size 1.1rem
    margin-bottom 18px
    font-weight 400
    letter-spacing 1px

// 移除更新日志左上角残留竖线
.update-header .page-title,
.update-header h1.page-title
  border-left none !important
  &::before
    display none !important

// ====== 正在开发提示 ======
.development-notice
  text-align center
  margin 0 0 18px 0
  .development-text
    display inline-block
    background linear-gradient(45deg, $accent, $primary)
    color white
    padding 8px 22px
    border-radius 25px
    font-size 1rem
    font-weight 600
    box-shadow 0 4px 15px rgba(255, 126, 179, 0.18)
    animation pulse 2s infinite
    position relative
    &::before
      content "🚧"
      margin-right 8px

@keyframes pulse
  0%
    transform scale(1)
    box-shadow 0 4px 15px rgba(255, 126, 179, 0.18)
  50%
    transform scale(1.05)
    box-shadow 0 6px 20px rgba(255, 126, 179, 0.28)
  100%
    transform scale(1)
    box-shadow 0 4px 15px rgba(255, 126, 179, 0.18)

// ====== 时间线主容器 ======
.timeline-container
  max-width 900px
  margin 0 auto
  padding 0 10px 60px 10px

.timeline
  position relative
  padding 40px 0
  &::before
    content ''
    display block
    position absolute
    top 0
    bottom 0
    left 50%
    width 3px
    background linear-gradient(to bottom, $primary, $secondary)
    transform translateX(-50%)
    z-index 0

// 强制隐藏其它所有相关伪元素
.timeline::after,
.timeline-container::before,
.timeline-container::after,
.timeline-item::before,
.timeline-item::after
  display none !important

// 强力隐藏被动态插入的主轴线div
.timeline > div[style*="position: absolute"][style*="left: 50%"]
  display none !important

// ====== 时间线卡片 ======
.timeline-item
  position relative
  margin-bottom 60px
  display flex
  justify-content flex-end
  z-index 1
  &:nth-child(even)
    justify-content flex-start

.timeline-content
  background $glass-bg
  border 1.5px solid $glass-border
  border-radius 20px
  padding 32px 32px 24px 32px
  width 44%
  min-width 260px
  box-shadow $shadow
  transition all 0.4s cubic-bezier(.4,2,.6,1)
  position relative
  z-index 2
  display flex
  flex-direction column
  align-items flex-start
  &:hover
    transform translateY(-8px) scale(1.025)
    box-shadow 0 16px 40px rgba(180,136,255,0.18)
  .date
    background linear-gradient(90deg, $primary, $secondary)
    color white
    padding 7px 18px
    border-radius 20px
    font-size 0.95rem
    font-weight 700
    display inline-block
    margin-bottom 6px !important
    margin-bottom 6px !important
    letter-spacing 1px
    margin-bottom 6px !important
  h3
    color $primary
    font-size 2.5em
    margin-bottom 6px !important
    margin-top 0 !important
    display flex
    align-items center
    i
      margin-right 10px
      font-size 1.2em
  .content
    color $text-main
    line-height 1.7
    font-size 1.05rem
    margin-bottom 10px
    margin-left 10px !important
  .updates
    padding-left 22px
    margin 15px 0 0 0
    li
      margin-bottom 8px
      position relative
      font-size 0.98rem
      &::before
        content "•"
        color $primary
        position absolute
        left -15px
  .tags
    margin-top 12px
    width 100%
    display flex
    flex-wrap nowrap
    justify-content center
    align-items center
    gap 12px
  .tag
    display inline-block
    background rgba(255,255,255,0.7)
    border 1px solid $glass-border
    padding 5px 16px
    border-radius 20px
    font-size 0.88rem
    margin 0
    color $primary
    font-weight 500
    transition all 0.3s
    white-space nowrap
    &:hover
      background $primary
      color white
      transform scale(1.08)

// ====== 响应式优化（移动端） ======
@media (max-width: 900px)
  #article-container {
    padding: 0 !important;
  }
  .timeline-container {
    max-width: 100vw !important;
    padding: 0 !important;
  }
  .timeline-content {
    width: 100% !important;
    min-width: unset !important;
    margin: 0 0 18px 0 !important;
    box-sizing: border-box;
    padding: 18px 10px 14px 10px !important;
    border-radius: 16px !important;
    font-size: 1rem;
    background: $glass-bg !important;
    border: 1.5px solid $glass-border !important;
    box-shadow: $shadow !important;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .timeline-content .content {
    margin-bottom: 10px;
    margin-left: 10px !important;
    color: $text-main;
    font-size: 1rem;
    line-height: 1.7;
  }
  .timeline-content .tags {
    width: 100%;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }
  .timeline-content .tag {
    display: inline-block;
    background: rgba(255,255,255,0.7);
    border: 1px solid $glass-border;
    padding: 5px 16px;
    border-radius: 20px;
    font-size: 0.92rem;
    margin: 0;
    color: $primary;
    font-weight: 500;
    transition: all 0.3s;
    text-decoration: none;
    vertical-align: middle;
    line-height: 1.5;
    white-space: nowrap;
  }
  .timeline-content .tag.selected,
  .timeline-content .tag:active {
    background: $primary;
    color: #fff;
    border-color: $primary;
  }
  .timeline-content .tag:active {
    transform: scale(0.97);
  }
  .timeline-content .tag:hover {
    background: $primary;
    color: #fff;
    border-color: $primary;
    transform: scale(1.08);
  }
  .timeline-content h3 {
    font-size: 2.5em !important;
    font-weight: 800;
    margin-bottom: 12px;
    margin-left: 10px !important;
    color: $primary;
    display: flex;
    align-items: center;
  }
  .timeline-content .date {
    margin-bottom: 6px !important;
    margin-left: 10px !important;
  }
  .timeline-content h3 {
    margin-top: 0 !important;
    margin-bottom: 12px;
  }
  .timeline-content .updates {
  background: rgba(255,255,255,0.55);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 14px 18px;
  margin: 10px 0 0 0;
  box-shadow: 0 2px 12px rgba(180,136,255,0.12);
  width: calc(100% - 20px);
  margin-left: 10px;
  margin-right: 10px;
}

