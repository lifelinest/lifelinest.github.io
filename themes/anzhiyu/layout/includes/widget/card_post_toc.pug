- let tocNumber = page.toc_number !== undefined ? page.toc_number : theme.toc.number
- let tocExpand = page.toc_expand !== undefined ? page.toc_expand : theme.toc.expand
- let tocExpandClass = tocExpand ? 'is-expand' : ''

#card-toc.card-widget
  .item-headline
    i.anzhiyufont.anzhiyu-icon-bars
    span= _p('aside.card_toc')
    span.toc-percentage

  //- 检查是否为加密文章
  if page.encrypted
    //- 目录遮罩，仅在加密文章未解锁时显示
    .article-encryption-mask.toc-encryption-mask#toc-encryption-mask
      .encryption-modal
        .encryption-header
          i.anzhiyufont.anzhiyu-icon-lock.encryption-icon
          span.encryption-title 目录已加密
        .encryption-hint
          i.anzhiyufont.anzhiyu-icon-lightbulb.hint-icon
          span 请先解锁正文

  //- 目录内容，加密文章初始隐藏
  .toc-content(class=tocExpandClass id="toc-content" style=page.encrypted ? "display: none;" : "")!=toc(page.content, {list_number: tocNumber})
      