    // 全局函数：显示相册详情（供模板调用）
    window.showAlbumDetail = function(pathName) {
        // 获取相册数据
        const albumData = !{JSON.stringify(site.data.album)};
        const album = albumData.find(item => item.path_name === pathName);
        
        if (!album) {
            console.error('Album not found:', pathName);
            return;
        }
        
        // 获取模态框元素
        const modalOverlay = document.querySelector('.modal-overlay');
        const modalImage = modalOverlay.querySelector('.modal-image');
        const modalTitle = modalOverlay.querySelector('.modal-title');
        const modalDescription = modalOverlay.querySelector('.modal-description');
        const cameraInfo = modalOverlay.querySelector('.camera-info');
        const lensInfo = modalOverlay.querySelector('.lens-info');
        const shutterInfo = modalOverlay.querySelector('.shutter-info');
        const isoInfo = modalOverlay.querySelector('.iso-info');
        const locationInfo = modalOverlay.querySelector('.location-info');
        
        if (modalOverlay && modalImage && modalTitle && modalDescription) {
            // 设置相册封面图片
            modalImage.src = album.cover;
            modalImage.alt = album.class_name;
            
            // 设置标题和描述
            modalTitle.textContent = album.class_name;
            modalDescription.textContent = album.description;
            
            // 设置相机信息
            if (cameraInfo) cameraInfo.textContent = album.camera || '未知';
            if (lensInfo) lensInfo.textContent = album.lens || '未知';
            if (shutterInfo) shutterInfo.textContent = album.shutter || '未知';
            if (isoInfo) isoInfo.textContent = album.iso || '未知';
            if (locationInfo) locationInfo.textContent = album.description || '未知';
            
            // 显示模态框
            modalOverlay.classList.add('active');
            document.body.classList.add('modal-open');
        }
    }
