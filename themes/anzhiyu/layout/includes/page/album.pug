              .detail-text.iso-info
            .detail-item
              .detail-icon
                i.fas.fa-map-marker-alt
              .detail-text.location-info

  script.
    // 相册页面JavaScript功能
    document.addEventListener('DOMContentLoaded', function() {
        // 模块切换功能
        const navItems = document.querySelectorAll('.nav-item');
        const moduleElements = document.querySelectorAll('.module');
        
        // 导航项点击事件
        navItems.forEach(item => {
            item.addEventListener('click', () => {
                // 移除所有活动状态
                navItems.forEach(i => i.classList.remove('active'));
                moduleElements.forEach(m => m.classList.remove('active'));
                
                // 添加当前活动状态
                item.classList.add('active');
                const moduleId = item.dataset.module + '-module';
                const targetModule = document.getElementById(moduleId);
                if (targetModule) {
                    targetModule.classList.add('active');
                }
            });
        });
        
        // 卡片点击事件（显示弹窗）
        const cards = document.querySelectorAll('.album-card');
        const modalOverlay = document.querySelector('.modal-overlay');
        const modalClose = document.querySelector('.modal-close');
        
        cards.forEach(card => {
            card.addEventListener('click', function(e) {
                // 确保点击的不是按钮
                if (!e.target.classList.contains('view-details-btn')) {
                    createRipple(e, this);
                    
                    // 检查是否有onclick属性（内联事件）
                    const onclickAttr = this.getAttribute('onclick');
                    if (onclickAttr && onclickAttr.includes('showAlbumDetail')) {
                        // 如果有内联的showAlbumDetail事件，不执行showModal
                        return;
                    }
                    
                    // 否则使用默认的showModal
                    showModal(this);
                    
                    // 移动设备触觉反馈
                    if (navigator.vibrate) {
                        navigator.vibrate(30);
                    }
                }
            });
        });
        
        // 关闭弹窗
        if (modalClose) {
            modalClose.addEventListener('click', () => {
                modalOverlay.classList.remove('active');
                document.body.classList.remove('modal-open');
            });
        }
        
        // 点击外部关闭弹窗
        if (modalOverlay) {
            modalOverlay.addEventListener('click', (e) => {
                if (e.target === modalOverlay) {
                    modalOverlay.classList.remove('active');
                    document.body.classList.remove('modal-open');
                }
            });
        }
        
        // 查看详情按钮点击事件
        const viewDetailBtns = document.querySelectorAll('.view-details-btn');
        viewDetailBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                createRipple(e, this);
                showModal(this.closest('.album-card'));
            });
        });
        
        // 创建波纹效果
        function createRipple(event, element) {
            const ripple = document.createElement("span");
            ripple.classList.add("ripple");
            
            // 设置波纹大小和位置
            const diameter = Math.max(element.clientWidth, element.clientHeight);
            const radius = diameter / 2;
            
            ripple.style.width = ripple.style.height = `${diameter}px`;
            ripple.style.left = `${event.clientX - element.getBoundingClientRect().left - radius}px`;
            ripple.style.top = `${event.clientY - element.getBoundingClientRect().top - radius}px`;
            
            element.appendChild(ripple);
            
            // 动画结束后移除元素
            setTimeout(() => {
                ripple.remove();
            }, 600);
        }
        
        // 显示弹窗
        function showModal(card) {
            if (!modalOverlay) return;
            
            const modalImage = modalOverlay.querySelector('.modal-image');
            const modalTitle = modalOverlay.querySelector('.modal-title');
            const modalDescription = modalOverlay.querySelector('.modal-description');
            const cameraInfo = modalOverlay.querySelector('.camera-info');
            const lensInfo = modalOverlay.querySelector('.lens-info');
            const shutterInfo = modalOverlay.querySelector('.shutter-info');
            const isoInfo = modalOverlay.querySelector('.iso-info');
            const locationInfo = modalOverlay.querySelector('.location-info');
            
            // 获取卡片数据
            const cardImage = card.querySelector('.card-image');
            const cardTitle = card.querySelector('.card-title');
            const cardLocation = card.querySelector('.card-location span');
            
            // 更新弹窗内容
            if (modalImage && cardImage) {
                modalImage.src = cardImage.src;
                modalImage.alt = cardImage.alt;
            }
            
            if (modalTitle && cardTitle) {
                modalTitle.textContent = cardTitle.textContent;
            }
            
            if (modalDescription) {
                modalDescription.textContent = cardLocation ? cardLocation.textContent : '这是一张精美的摄影作品，展现了独特的视角和构图。';
            }
            
            // 从album.yml数据中获取相机信息
            const albumData = !{JSON.stringify(site.data.album)};
            const cardTitleText = cardTitle ? cardTitle.textContent : '';
            const currentAlbum = albumData.find(item => item.class_name === cardTitleText);
            
            if (currentAlbum) {
                // 使用真实数据
                if (cameraInfo) cameraInfo.textContent = currentAlbum.camera || 'Sony A7III';
                if (lensInfo) lensInfo.textContent = currentAlbum.lens || '35mm f/1.8';
                if (shutterInfo) shutterInfo.textContent = currentAlbum.shutter || '1/200s';
                if (isoInfo) isoInfo.textContent = currentAlbum.iso || 'ISO 400';
                if (locationInfo) locationInfo.textContent = currentAlbum.description || (cardLocation ? cardLocation.textContent : '');
            } else {
                // 使用默认值
                if (cameraInfo) cameraInfo.textContent = 'Sony A7III';
                if (lensInfo) lensInfo.textContent = '35mm f/1.8';
                if (shutterInfo) shutterInfo.textContent = '1/200s';
                if (isoInfo) isoInfo.textContent = 'ISO 400';
                if (locationInfo && cardLocation) locationInfo.textContent = cardLocation.textContent;
            }
            
            modalOverlay.classList.add('active');
            document.body.classList.add('modal-open');
        }
        
        // 键盘事件处理
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modalOverlay && modalOverlay.classList.contains('active')) {
                modalOverlay.classList.remove('active');
                document.body.classList.remove('modal-open');
            }
        });
        
                    // 桌面端分页功能
            const paginationBtns = document.querySelectorAll('.pagination-btn');
            paginationBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const module = this.dataset.module;
                    const page = parseInt(this.dataset.page);
                    loadPage(module, page);
                });
            });
            
            // 移动端导航功能
            const mobileNavBtns = document.querySelectorAll('.mobile-nav');
            mobileNavBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const module = this.dataset.module;
                    const direction = this.classList.contains('prev') ? 'prev' : 'next';
                    navigateMobile(module, direction);
                });
            });
            
            // 移动端导航函数
            function navigateMobile(moduleType, direction) {
                const module = document.getElementById(moduleType + '-module');
                if (!module) return;
                
                const mobileContainer = module.querySelector('.album-mobile');
                if (!mobileContainer) return;
                
                const cards = mobileContainer.querySelectorAll('.album-card');
                const currentCard = mobileContainer.querySelector('.album-card.active');
                const pagination = mobileContainer.querySelector('.mobile-pagination');
                
                if (!currentCard || cards.length <= 1) return;
                
                const currentIndex = parseInt(currentCard.dataset.index);
                let newIndex;
                
                if (direction === 'prev') {
                    newIndex = currentIndex > 0 ? currentIndex - 1 : cards.length - 1;
                } else {
                    newIndex = currentIndex < cards.length - 1 ? currentIndex + 1 : 0;
                }
                
                // 更新当前卡片
                currentCard.classList.remove('active');
                cards[newIndex].classList.add('active');
                
                // 更新页码显示
                if (pagination) {
                    pagination.textContent = `${newIndex + 1} / ${cards.length}`;
                }
                
                // 更新导航按钮状态
                const prevBtn = mobileContainer.querySelector('.mobile-nav.prev');
                const nextBtn = mobileContainer.querySelector('.mobile-nav.next');
                
                if (prevBtn) {
                    prevBtn.disabled = newIndex === 0;
                }
                if (nextBtn) {
                    nextBtn.disabled = newIndex === cards.length - 1;
                }
            }
        

        
        // 图片懒加载功能
        function initLazyLoading() {
            const imageObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;
                        const placeholder = img.parentElement.querySelector('.card-image-placeholder');
                        
                        // 预加载图片
                        const tempImg = new Image();
                        tempImg.onload = function() {
                            img.src = img.dataset.src;
                            img.classList.add('loaded');
                            if (placeholder) {
                                placeholder.style.display = 'none';
                            }
                            observer.unobserve(img);
                        };
                        tempImg.onerror = function() {
                            // 图片加载失败时的处理
                            img.src = 'data:image/svg+xml;base64,';
                            img.classList.add('loaded');
                            if (placeholder) {
                                placeholder.style.display = 'none';
                            }
                            observer.unobserve(img);
                        };
                        tempImg.src = img.dataset.src;
                    }
                });
            }, {
                rootMargin: '50px 0px', // 提前50px开始加载
                threshold: 0.1
            });

            // 观察所有懒加载图片
            document.querySelectorAll('img[data-src]').forEach(img => {
                imageObserver.observe(img);
            });
        }

        // 分页按钮点击事件
        document.addEventListener('click', function(e) {
            if (e.target.closest('.pagination-btn')) {
                e.preventDefault();
                const btn = e.target.closest('.pagination-btn');
                const moduleType = btn.dataset.module;
                const page = parseInt(btn.dataset.page);
                
                // 检查按钮是否被禁用（通过类名或disabled属性）
                if (moduleType && page && !btn.classList.contains('disabled') && !btn.hasAttribute('disabled')) {
                    loadPage(moduleType, page);
                }
            }
        });
        
        // 加载指定页面的函数
        function loadPage(moduleType, page) {
            const module = document.getElementById(moduleType + '-module');
            if (!module) return;
            
            const albumData = !{JSON.stringify(site.data.album)};
            const filteredAlbums = albumData.filter(item => item.type === moduleType);
            const perPage = 6;
            const start = (page - 1) * perPage;
            const end = start + perPage;
            const currentAlbums = filteredAlbums.slice(start, end);
            
            // 更新相册网格
            const albumGrid = module.querySelector('.album-grid');
            if (albumGrid) {
                albumGrid.innerHTML = '';
                
                // 添加相册卡片
                currentAlbums.forEach(album => {
                    const card = document.createElement('div');
                    card.className = 'album-card';
                    card.onclick = () => showAlbumDetail(album.path_name);
                    card.innerHTML = `
                        <div class="card-image-placeholder"></div>
                        <img class="card-image" data-src="${album.cover}" alt="${album.class_name}" loading="lazy">
                        <div class="card-overlay">
                            <h3 class="card-title">${album.class_name}</h3>
                            <div class="card-location">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>${album.description}</span>
                            </div>
                        </div>
                        <div class="view-details-btn">查看详情</div>
                    `;
                    albumGrid.appendChild(card);
                });
                
                // 添加占位符填充到6个
                const placeholderCount = perPage - currentAlbums.length;
                for (let i = 0; i < placeholderCount; i++) {
                    const placeholder = document.createElement('div');
                    placeholder.className = 'album-placeholder';
                    placeholder.innerHTML = `
                        <div style="text-align: center;">
                            <i class="fas fa-camera" style="font-size: 24px; margin-bottom: 8px; display: block; opacity: 0.6;"></i>
                            <span>敬请期待</span>
                        </div>
                    `;
                    albumGrid.appendChild(placeholder);
                }
            }
            
            // 更新分页按钮状态
            const totalPages = Math.ceil(filteredAlbums.length / perPage);
            const prevBtn = module.querySelector('.pagination-btn.prev');
            const nextBtn = module.querySelector('.pagination-btn.next');
            const paginationInfo = module.querySelector('.pagination-info');
            
            if (prevBtn) {
                prevBtn.dataset.page = page - 1;
                if (page <= 1) {
                    prevBtn.classList.add('disabled');
                    prevBtn.setAttribute('disabled', 'disabled');
                } else {
                    prevBtn.classList.remove('disabled');
                    prevBtn.removeAttribute('disabled');
                }
            }
            
            if (nextBtn) {
                nextBtn.dataset.page = page + 1;
                if (page >= totalPages) {
                    nextBtn.classList.add('disabled');
                    nextBtn.setAttribute('disabled', 'disabled');
                } else {
                    nextBtn.classList.remove('disabled');
                    nextBtn.removeAttribute('disabled');
                }
            }
            
            if (paginationInfo) {
                paginationInfo.textContent = `第 ${page} 页，共 ${totalPages} 页`;
            }
            
            // 重新绑定卡片事件
            const newCards = module.querySelectorAll('.album-card');
            newCards.forEach(card => {
                card.addEventListener('click', function(e) {
                    if (!e.target.classList.contains('view-details-btn')) {
                        createRipple(e, this);
                        showModal(this);
                    }
                });
            });
            
            const newViewBtns = module.querySelectorAll('.view-details-btn');
            newViewBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    createRipple(e, this);
                    showModal(this.closest('.album-card'));
                });
            });
        }
        
        // 初始化懒加载
        initLazyLoading();
        
        // 初始化：如果没有数据，显示默认内容
        let hasContent = false;
        
        moduleElements.forEach(module => {
            if (module.children.length > 0) {
                hasContent = true;
            }
        });
        
        if (!hasContent) {
            // 显示默认的示例内容
            showDefaultContent();
        }
    });
    
    // 显示默认内容
    function showDefaultContent() {
        const cityModule = document.getElementById('city-module');
        if (cityModule) {
            cityModule.innerHTML = `
                <div class="album-card">
                    <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?ixlib=rb-4.0.3&auto=format&fit=crop&w=1473&q=80" alt="城市建筑" class="card-image">
                    <div class="card-overlay">
                        <h3 class="card-title">巴黎清晨</h3>
                                                   <div class="card-location">
                               <i class="fas fa-map-marker-alt"></i>
                               <span>法国巴黎</span>
                           </div>
                    </div>
