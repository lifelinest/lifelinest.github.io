#album
  style.
    /* 相册页面样式 */
    :root {
      --album-primary-color: #6478ec;
      --album-secondary-color: #ff7e5f;
      --album-dark-color: #1a1a2e;
      --album-light-color: #ffffff;
      --album-gray-light: #f5f7fa;
      --album-transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    
    /* 相册容器 */
    .album-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 20px;
    }
    
    /* 模块导航 */
    .module-nav {
      display: flex;
      justify-content: center;
      margin-bottom: 40px;
      flex-wrap: wrap;
      gap: 10px;
    }
    
    .nav-item {
      padding: 12px 30px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 30px;
      cursor: pointer;
      transition: var(--album-transition);
      background: var(--album-gray-light);
      color: #555;
      border: 2px solid transparent;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .nav-item.active {
      background: var(--album-primary-color);
      color: white;
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(100, 120, 236, 0.3);
    }
    
    .nav-item:hover:not(.active) {
      border-color: var(--album-primary-color);
      color: var(--album-primary-color);
    }
    
    /* 模块容器 */
    .modules-container {
      position: relative;
      min-height: 600px; /* 增加高度以容纳分页控件 */
    }
    
    .module {
      position: relative;
      width: 100%;
      opacity: 0;
      visibility: hidden;
      transform: translateY(20px);
      transition: var(--album-transition);
      padding: 20px;
      display: none;
    }
    
    .module.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      display: block;
    }
    
    /* 桌面端网格布局 - 3×2正方形布局 */
    .album-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr); /* 3列 */
      grid-template-rows: repeat(2, 1fr); /* 2行 */
      gap: 30px;
      margin-bottom: 20px;
      max-width: 1200px; /* 限制最大宽度，确保正方形比例 */
      margin-left: auto;
      margin-right: auto;
    }
    
    /* 相册卡片 */
    .album-card {
      position: relative;
      aspect-ratio: 1; /* 保持正方形比例 */
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      transition: var(--album-transition);
      cursor: pointer;
      background: var(--album-light-color);
      margin-bottom: 0;
    }
    
    .album-card:hover {
      transform: translateY(-15px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15), 0 0 0 3px var(--album-primary-color);
    }
    
    .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: var(--album-transition);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .card-image.loaded {
      opacity: 1;
    }

    /* 加载占位符 */
    .card-image-placeholder {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
      z-index: 1;
    }

    @keyframes loading {
      0% {
        background-position: 200% 0;
      }
      100% {
        background-position: -200% 0;
      }
    }

    /* 暗色模式下的加载占位符 */
    [data-theme="dark"] .card-image-placeholder {
      background: linear-gradient(90deg, #2d3748 25%, #4a5568 50%, #2d3748 75%);
      background-size: 200% 100%;
    }
    
    .album-card:hover .card-image {
      transform: scale(1.05);
      filter: brightness(1.1);
    }
    
    .card-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 25px 20px;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent 70%);
      color: white;
      opacity: 0;
      transition: var(--album-transition);
      z-index: 2;
    }
    
    .album-card:hover .card-overlay {
      opacity: 1;
    }
    
    .card-title {
      font-size: 1.5rem;
      margin-bottom: 8px;
      position: relative;
      display: inline-block;
    }
    
    .card-title::after {
      content: "";
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 3px;
      background: var(--album-primary-color);
      transition: width 0.5s ease;
    }
    
    .album-card:hover .card-title::after {
      width: 100%;
    }
    
    .card-location {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.95rem;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.5s ease 0.1s;
    }
    
    .album-card:hover .card-location {
      opacity: 1;
      transform: translateY(0);
    }
    
    .view-details-btn {
      position: absolute;
      bottom: -50px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 30px;
      background: var(--album-primary-color);
      color: white;
      border: none;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
      opacity: 0;
      transition: all 0.5s ease 0.2s;
      box-shadow: 0 5px 15px rgba(100, 120, 236, 0.4);
      z-index: 3;
    }
    
    .album-card:hover .view-details-btn {
      bottom: 20px;
      opacity: 1;
    }
    
    .view-details-btn:hover {
      background: #5468e0;
      transform: translateX(-50%) scale(1.05);
    }
    
    /* 详情弹窗 */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      transition: var(--album-transition);
      backdrop-filter: blur(5px);
    }
    
    /* 当弹窗激活时，禁用背景页面 */
    body.modal-open {
      overflow: hidden !important;
      pointer-events: none;
      position: fixed;
      width: 100%;
      height: 100%;
    }
    
    body.modal-open .album-container {
      pointer-events: none;
    }
    
    /* 弹窗内容可以交互 */
    .modal-overlay.active {
      pointer-events: auto;
    }
    
    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    
    .modal-content {
      background: white;
      width: 90%;
      max-width: 900px;
      border-radius: 20px;
      overflow: hidden;
      transform: scale(0.9);
      transition: transform 0.4s ease;
      position: relative;
    }
    
    /* 暗黑模式下的弹窗内容 */
    [data-theme="dark"] .modal-content {
      background: #1a1a1a;
    }
    
    .modal-overlay.active .modal-content {
      transform: scale(1);
    }
    
    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      color: #333;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      z-index: 10;
      transition: var(--album-transition);
    }
    
    .modal-close:hover {
      background: var(--album-primary-color);
      color: white;
      transform: rotate(90deg);
    }
    
    /* 暗黑模式下的关闭按钮 */
    [data-theme="dark"] .modal-close {
      background: rgba(30, 30, 30, 0.9);
      color: #fff;
    }
    
    [data-theme="dark"] .modal-close:hover {
      background: var(--album-primary-color);
      color: white;
    }
    
    .modal-header {
      position: relative;
      height: 400px;
    }
    
    .modal-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .modal-info {
      padding: 30px;
    }
    
    .modal-title {
      font-size: 2rem;
      margin-bottom: 15px;
      color: var(--album-dark-color);
    }
    
    .modal-description {
      color: #555;
      line-height: 1.8;
      margin-bottom: 25px;
    }
    
    /* 暗黑模式下的文字颜色 */
    [data-theme="dark"] .modal-title {
      color: #fff;
    }
    
    [data-theme="dark"] .modal-description {
      color: #ccc;
    }
    
    .modal-details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 25px;
    }
    
    .detail-item {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    
    .detail-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(100, 120, 236, 0.1);
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--album-primary-color);
      font-size: 1.2rem;
      transition: var(--album-transition);
    }
    
    /* 暗黑模式下的详情图标 */
    [data-theme="dark"] .detail-icon {
      background: rgba(100, 120, 236, 0.2);
      color: #fff;
    }
    
    .detail-text {
      font-weight: 500;
      color: #333;
    }
    
    /* 暗黑模式下的详情文字 */
    [data-theme="dark"] .detail-text {
      color: #fff;
    }
    
    /* 波纹效果 */
    .ripple {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.7);
      transform: scale(0);
      animation: ripple 0.6s linear;
      pointer-events: none;
    }
    
    @keyframes ripple {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }
    
    /* 响应式设计 */
    @media (max-width: 768px) {
      .nav-item {
        padding: 10px 20px;
        font-size: 1rem;
      }
      
      .album-card {
        height: 300px;
      }
      
      .modal-header {
        height: 300px;
      }
      
      .card-overlay {
        padding: 15px;
      }
      
      .card-title {
        font-size: 1.3rem;
      }
      
      .album-container {
        padding: 10px;
      }
      
      .module {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        padding: 10px;
      }
    }
    
    /* 深色模式适配 */
    [data-theme="dark"] .album-card {
      background: var(--anzhiyu-card-bg);
      color: var(--anzhiyu-fontcolor);
    }
    
    [data-theme="dark"] .modal-content {
      background: var(--anzhiyu-card-bg);
      color: var(--anzhiyu-fontcolor);
    }
    
    [data-theme="dark"] .modal-title {
      color: var(--anzhiyu-fontcolor);
    }
    
    [data-theme="dark"] .modal-description {
      color: var(--anzhiyu-fontcolor);
    }
    
    [data-theme="dark"] .nav-item {
      background: var(--anzhiyu-card-bg);
      color: var(--anzhiyu-fontcolor);
    }
    
    [data-theme="dark"] .nav-item:hover:not(.active) {
      border-color: var(--album-primary-color);
      color: var(--album-primary-color);
    }
    
    /* 相册网格布局 - 桌面端3×2 */
    .album-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 30px;
      margin-bottom: 40px;
      min-height: 600px;
    }
    
    /* 移动端相册布局 - 1×1 */
    .album-mobile {
      display: none;
      position: relative;
      width: 100%;
      margin-bottom: 20px;
      height: auto; /* 自适应高度 */
    }
    
    .album-mobile .album-card {
      width: 100%;
      height: 350px; /* 减少照片高度，为导航控件留出空间 */
      opacity: 0;
      transition: opacity 0.3s ease;
      margin: 0;
      display: none;
      position: relative;
    }
    
    .album-mobile .album-card.active {
      opacity: 1;
      display: block;
    }
    
    .album-mobile .card-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    /* 移动端导航容器 */
    .mobile-nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 15px; /* 减少间距 */
      padding: 0 20px;
    }
    
    /* 移动端导航箭头 */
    .mobile-nav {
      width: 50px;
      height: 50px;
      background: rgba(255, 255, 255, 0.9);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--album-transition);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      border: none;
      font-size: 18px;
    }
    
    .mobile-nav:hover {
      background: var(--album-primary-color);
      color: white;
      transform: scale(1.1);
    }
    
    .mobile-nav:disabled {
      background: #ccc;
      cursor: not-allowed;
      transform: none;
    }
    
    /* 移动端页码显示 */
    .mobile-pagination {
      background: rgba(255, 255, 255, 0.9);
      color: #333;
      padding: 10px 20px;
      border-radius: 25px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    
    /* 分页容器 */
    .pagination-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 40px;
      padding: 20px 0;
      position: relative;
    }
    
          /* 桌面端分页容器样式 */
      .pagination-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 30px;
        margin-bottom: 20px;
        width: 100%;
      }
      
      /* 桌面端分页样式 */
      .pagination-desktop {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        background: rgba(255, 255, 255, 0.9);
        padding: 15px 30px;
        border-radius: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(10px);
        min-width: 300px;
      }
    
          .pagination-btn {
        width: 40px;
        height: 40px;
        background: var(--album-primary-color);
        color: white;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        font-weight: 600;
        transition: var(--album-transition);
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
      }
    
          .pagination-btn:hover {
        background: #4a5fd8;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(100, 120, 236, 0.3);
      }
      
              .pagination-btn.disabled {
          background: #ccc;
          cursor: not-allowed;
          opacity: 0.5;
          pointer-events: none;
        }

        .pagination-btn.disabled:hover {
          background: #ccc;
          transform: none;
          box-shadow: none;
        }

        /* 占位符样式 */
        .album-placeholder {
          aspect-ratio: 1;
          border: 2px dashed #ccc;
          border-radius: 16px;
          background: #f8f9fa;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #6c757d;
          font-size: 16px;
          font-weight: 500;
          transition: var(--album-transition);
          cursor: default;
        }

        .album-placeholder:hover {
          border-color: #adb5bd;
          background: #e9ecef;
          color: #495057;
        }

        /* 暗色模式下的占位符 */
        [data-theme="dark"] .album-placeholder {
          border-color: #495057;
          background: #2d3748;
          color: #a0aec0;
        }

        [data-theme="dark"] .album-placeholder:hover {
          border-color: #718096;
          background: #4a5568;
          color: #cbd5e0;
        }
    
    .pagination-btn:disabled {
      background: #ccc;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    
    .pagination-info {
      font-weight: 600;
      color: #333;
      font-size: 14px;
    }
    

    
    /* 暗黑模式下的分页样式 */
    [data-theme="dark"] .pagination-desktop {
      background: rgba(30, 30, 30, 0.9);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }
    
    [data-theme="dark"] .pagination-info {
      color: #fff;
    }
    
    [data-theme="dark"] .mobile-nav {
      background: rgba(30, 30, 30, 0.9);
      color: #fff;
    }
    
    [data-theme="dark"] .mobile-nav:hover {
      background: var(--album-primary-color);
      color: white;
    }
    
    [data-theme="dark"] .mobile-pagination {
      background: rgba(30, 30, 30, 0.9);
      color: #fff;
    }
    

    
    /* 移动设备优化 */
    @media screen and (max-width: 768px) {
      .album-container {
        padding: 20px;
      }
      
      .module-nav {
        flex-wrap: wrap;
        gap: 10px;
      }
      
      .nav-item {
        padding: 12px 20px;
        font-size: 0.9rem;
      }
      
      /* 移动端模块容器高度自适应 */
      .modules-container {
        min-height: auto !important;
        height: auto !important;
      }
      
      /* 移动端隐藏桌面端布局 */
      .album-grid {
        display: none !important;
      }
      
      /* 显示移动端布局 */
      .album-mobile {
        display: block !important;
      }
      
      /* 隐藏桌面端分页 */
      .pagination-desktop {
        display: none !important;
      }
      
      /* 隐藏桌面端分页容器 */
      .pagination-wrapper {
        display: none !important;
      }
      
      .modal-content {
        width: 95%;
        margin: 20px;
      }
      
      .modal-header {
        height: 300px;
      }
      
      .modal-details {
        grid-template-columns: 1fr;
        gap: 15px;
      }
    }
    
    /* 平板设备优化 */
    @media screen and (min-width: 769px) and (max-width: 1024px) {
      .album-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(3, 1fr);
      }
    }

  - let album_background = page.top_background
  .author-content.author-content-item.album.single(style=`${album_background ? `background: url(${album_background}) top / cover no-repeat;` : ""}`)
    .card-content
      .author-content-item-tips 相册集
      span.author-content-item-title 咔嚓星球的视觉游乐园
      .content-bottom
        .tips ⚡ 举相机预备——3️⃣2️⃣1️⃣...茄子炸弹💣！”
      .banner-button-group
        a.banner-button(href='/about/')
          i.fas.fa-arrow-circle-right(style='font-size: 1.5rem')
          span.banner-button-text 关于本人

  .album-container
    // 模块导航
    .module-nav
      .nav-item.active(data-module="city")
        i.fas.fa-building
        span 城市韵律
      .nav-item(data-module="nature")
        i.fas.fa-tree
        span 自然物语
      .nav-item(data-module="portrait")
        i.fas.fa-user
        span 人像故事
      .nav-item(data-module="still")
        i.fas.fa-camera
        span 静物微光

    // 模块容器
    .modules-container
      // 城市韵律模块
      .module.active#city-module
        // 桌面端3×2网格布局
        .album-grid
          - let cityAlbums = site.data.album.filter(item => item.type === 'city')
          - let cityPage = 1
          - let cityPerPage = 6
          - let cityStart = (cityPage - 1) * cityPerPage
          - let cityEnd = cityStart + cityPerPage
          - let cityCurrentAlbums = cityAlbums.slice(cityStart, cityEnd)
          each i in cityCurrentAlbums
            .album-card(onclick=`showAlbumDetail("${i.path_name}")`)
              .card-image-placeholder
              img.card-image(data-src=i.cover alt=i.class_name loading="lazy")
              .card-overlay
                h3.card-title=i.class_name
                .card-location
                  i.fas.fa-map-marker-alt
                  span=i.description
              .view-details-btn 查看详情
        
        // 移动端1×1布局
        .album-mobile
          - let cityAlbumsMobile = site.data.album.filter(item => item.type === 'city')
          each i, index in cityAlbumsMobile
            .album-card(class=index === 0 ? 'active' : '' data-index=index onclick=`showAlbumDetail("${i.path_name}")`)
              .card-image-placeholder
              img.card-image(data-src=i.cover alt=i.class_name loading="lazy")
              .card-overlay
                h3.card-title=i.class_name
                .card-location
                  i.fas.fa-map-marker-alt
                  span=i.description
              .view-details-btn 查看详情
          
          // 移动端导航控件（在相册卡片外面）
          if cityAlbumsMobile.length > 1
            .mobile-nav-container
              .mobile-nav.prev(data-module="city")
                i.fas.fa-chevron-left
              .mobile-pagination 1 / #{cityAlbumsMobile.length}
              .mobile-nav.next(data-module="city")
                i.fas.fa-chevron-right
        
        // 桌面端分页
        .pagination-wrapper#city-pagination
          - let cityTotalPages = Math.ceil(cityAlbums.length / cityPerPage)
          .pagination-desktop
            .pagination-btn.prev(data-module="city" data-page=cityPage-1 title="上一页" class=cityPage <= 1 ? 'disabled' : '')
              i.fas.fa-chevron-left
            .pagination-info 第 #{cityPage} 页，共 #{cityTotalPages} 页
            .pagination-btn.next(data-module="city" data-page=cityPage+1 title="下一页" class=cityPage >= cityTotalPages ? 'disabled' : '')
              i.fas.fa-chevron-right

      // 自然物语模块
      .module#nature-module
        // 桌面端3×2网格布局
