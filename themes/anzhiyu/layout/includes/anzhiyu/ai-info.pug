- let pageFillDescription = get_page_fill_description()
- let gptName = theme.post_head_ai_description.gptName
- let mode = theme.post_head_ai_description.mode
- let switchBtn = theme.post_head_ai_description.switchBtn
if (pageFillDescription && page.ai)
  .post-ai-description
    .ai-title
      i.anzhiyufont.anzhiyu-icon-bilibili
      .ai-title-text AI-摘要
      if (switchBtn)
        #ai-Toggle 切换
      i.anzhiyufont.anzhiyu-icon-arrow-rotate-right
      i.anzhiyufont.anzhiyu-icon-circle-dot(title="朗读摘要")
      #ai-tag(style="margin-left:auto")
        = gptName
    .ai-explanation AI初始化中...
    .ai-btn-box
      .ai-btn-item
        i.anzhiyufont.anzhiyu-icon-hand-heart-fill(style="vertical-align:-1px;margin-right:5px")
        | 介绍自己
      .ai-btn-item
        i.anzhiyufont.anzhiyu-icon-pencil(style="vertical-align:-1px;margin-right:5px")
        | 生成本文简介
      .ai-btn-item
        i.anzhiyufont.anzhiyu-icon-book-open(style="vertical-align:-1px;margin-right:5px")
        | 推荐相关文章
      .ai-btn-item
        i.anzhiyufont.anzhiyu-icon-house-chimney(style="vertical-align:-1px;margin-right:5px")
        | 前往主页
    script(data-pjax src=url_for(theme.asset.ai_abstract_js))
